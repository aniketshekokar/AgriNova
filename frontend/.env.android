# ─────────────────────────────────────────────────────────────────────────────
# AgriNova Android Build Environment
# ─────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT: Before building the Android APK, replace YOUR_PC_LAN_IP below
# with the actual IPv4 address of your development PC on your local network.
#
# How to find your PC's IPv4 address:
#   1. Open Command Prompt (cmd)
#   2. Run: ipconfig
#   3. Look for "IPv4 Address" under your active network adapter
#      (e.g., 192.168.1.100 or 10.0.0.5)
#
# Example:
#   VITE_API_URL=http://192.168.1.100:5000/api
#
# Your Android device/emulator must be on the same Wi-Fi network as your PC.
# If your backend is deployed online, use that URL instead.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://YOUR_PC_LAN_IP:5000/api

# Google Maps Platform credentials
VITE_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE
